    "@x402/fetch": "^2.31.0",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
